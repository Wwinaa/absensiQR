# Database Configuration
DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=
DB_NAME=db_absensi_smk

# App Config
APP_URL=http://localhost/absen
APP_NAME="Sistem Presensi SMK NU Wargabinangun"
